---
import CtaButton from './CtaButton.astro';
import Photo from './Photo.astro';
import BrandArt from './BrandArt.astro';
import { photos } from '../content/photos';
import { hero } from '../content/copy';
const words = hero.headline.split(' ');
---

<section class="hero" id="topo" data-parallax-scope>
  <!-- Elementos gráficos provisórios: substituir pelas ilustrações oficiais do brand book. -->
  <div class="hero__art">
    <div aria-hidden="true" class="hero__shape hero__shape--sun" data-depth="-18" data-scroll-speed="0.25"></div>
    <div aria-hidden="true" class="hero__shape hero__shape--dot" data-depth="30" data-scroll-speed="-0.15"></div>
    <div aria-hidden="true" class="hero__shape hero__shape--ring" data-depth="12" data-scroll-speed="0.4"></div>
    <div class="hero__photo" data-depth="-8" data-scroll-speed="0.12">
      <Photo photo={photos.hero} shape="arch" ratio="3:4" sizes="(min-width: 760px) 24rem, 40vw" priority class="hero__ph" />
    </div>
    <div aria-hidden="true" class="hero__ill" data-depth="22" data-scroll-speed="-0.3"><BrandArt art="caixas" /></div>
    <svg aria-hidden="true" class="hero__squiggle" data-depth="-26" viewBox="0 0 220 60"><path d="M4 40 C 30 4, 52 4, 70 32 S 110 58, 130 28 S 178 2, 216 30" fill="none" stroke="var(--fucinho)" stroke-width="4" stroke-linecap="round" pathLength="1" /></svg>
  </div>

  <div class="hero__content wrap">
    <h1 class="hero__title" aria-label={hero.headline}>
      {words.map((w, i) => (
        <span class="hero__word" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>
      ))}
    </h1>
    <p class="hero__support hero__in" style="--i:4">{hero.support}</p>
    <div class="hero__cta hero__in" style="--i:6">
      <CtaButton origin="hero" />
    </div>
  </div>

</section>

<style>
  .hero {
    --px: 0;
    --py: 0;
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: 7rem clamp(3rem, 8vh, 5.5rem);
    overflow: clip;
    isolation: isolate;
  }
  .hero__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__art > * {
    position: absolute;
    --sy: 0px;
    translate: calc(var(--px) * var(--d, 0) * 1px) calc(var(--py) * var(--d, 0) * 1px + var(--sy));
    will-change: translate;
  }
  .hero__shape--sun {
    width: min(58vw, 34rem);
    aspect-ratio: 1;
    right: -12vw;
    top: 8vh;
    border-radius: 50%;
    background: var(--patinha);
  }
  .hero__shape--dot {
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--fucinho);
    left: 8vw;
    top: 18vh;
  }
  .hero__shape--ring {
    width: 9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid var(--terra);
    right: 40vw;
    top: 12vh;
  }
  .hero__photo {
    width: min(42vw, 23rem);
    aspect-ratio: 3 / 4;
    right: 9vw;
    top: 17vh;
    rotate: 4deg;
  }
  /* Caixas PetVila vetorizadas do print da embalagem. */
  .hero__ill {
    width: min(17vw, 14rem);
    right: 31vw;
    top: 44vh;
    rotate: -6deg;
    filter: drop-shadow(0 1.2rem 1.4rem color-mix(in srgb, var(--fucinho) 22%, transparent));
  }
  .hero :global(.hero__ph) {
    width: 100%;
    height: 100%;
  }
  .hero__squiggle {
    width: 13rem;
    left: 44vw;
    top: 9vh;
  }
  .motion .hero__squiggle path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.6s 0.9s var(--ease-out) forwards;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  .hero__content {
    position: relative;
  }
  .hero__title {
    font-size: clamp(3.2rem, 1.4rem + 6.2vw, 8.25rem);
    max-width: 11ch;
    line-height: 0.92;
    margin-bottom: 1.75rem;
  }
  .hero__word {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.15em;
    padding-bottom: 0.06em;
    margin-right: 0.22em;
    vertical-align: top;
  }
  .hero__word > span {
    display: inline-block;
  }
  .motion .hero__word > span {
    transform: translateY(105%) rotate(6deg);
    animation: rise 1.1s calc(150ms + var(--i) * 85ms) var(--ease-out) forwards;
  }
  @keyframes rise {
    to { transform: none; }
  }
  /* Entrada no carregamento (não depende de scroll: o Hero já está na tela). */
  .motion .hero__in {
    opacity: 0;
    transform: translateY(1.5rem);
    animation: fadeUp 1s calc(250ms + var(--i) * 85ms) var(--ease-out) forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: none; }
  }
  .hero__support {
    font-size: var(--step-1);
    max-width: 30ch;
    color: var(--ink-soft);
    margin-bottom: 2.25rem;
  }

  /* Mobile: arte no topo, texto embaixo, sem sobreposição com a copy. */
  @media (max-width: 759px) {
    .hero {
      align-items: end;
      padding-top: 36svh;
      padding-bottom: 1.5rem;
    }
    .hero__shape--sun { width: 64vw; right: -20vw; top: 13svh; }
    .hero__photo { width: 36vw; right: 12vw; top: 15svh; }
    .hero__ill { width: 23vw; right: auto; left: 11vw; top: 22svh; }
    .hero__shape--ring { width: 4.5rem; right: auto; left: 34vw; top: 14svh; }
    .hero__shape--dot { width: 2.2rem; left: 6vw; top: 17svh; }
    .hero__squiggle { width: 6.5rem; left: 6vw; top: 41svh; }
    .hero__title { font-size: clamp(2.6rem, 12vw, 4.4rem); margin-bottom: 1rem; }
    .hero__support { font-size: 1.05rem; margin-bottom: 1.5rem; }
    .hero :global(.ph__tag) { font-size: 0.55rem; margin: 10%; }
  }
</style>
