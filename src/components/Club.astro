---
import CtaButton from './CtaButton.astro';
import BrandArt from './BrandArt.astro';
import { club, cta, store } from '../content/copy';
---

<section class="club" id="club" aria-labelledby="club-title">
  <div class="wrap club__wrap">
    <h2 id="club-title" class="club__title" data-reveal>{club.headline}</h2>
    <div class="club__box" aria-hidden="true" data-reveal style="--reveal-i:1"><BrandArt art="caixa" /></div>

    <div class="club__plans">
      {club.plans.map((p, i) => (
        <article id={`vila-${p.id}`} class={`plan ${p.core ? 'plan--core' : ''}`} data-reveal style={`--reveal-i:${i + 1}`} data-plan={p.id} aria-labelledby={`plan-${p.id}`}>
          <div class="plan__blob" aria-hidden="true"></div>
          <span class="plan__soon">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <defs><path id={`c-${p.id}`} d="M50 50 m-36 0 a36 36 0 1 1 72 0 a36 36 0 1 1 -72 0" /></defs>
              <text><textPath href={`#c-${p.id}`}>EM BREVE · EM BREVE · EM BREVE ·</textPath></text>
            </svg>
            <span class="visually-hidden">{club.soon}</span>
          </span>
          <h3 id={`plan-${p.id}`} class="plan__name">{p.name}</h3>
          <p class="plan__tagline">{p.tagline}</p>
          <p class="plan__copy">{p.copy}</p>
          <p class="plan__count"><strong>{p.count}</strong> {club.perMonth}</p>
          <p class="plan__cycle">{club.cycle}</p>
          <ul class="plan__items">
            {p.items.map((item) => <li>{item}</li>)}
          </ul>
          {p.originals && (
            <div class="plan__originals">
              <p class="plan__originals-title">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2.5l2.6 6.2 6.7.6-5.1 4.4 1.5 6.6L12 16.8l-5.7 3.5 1.5-6.6-5.1-4.4 6.7-.6z" fill="currentColor" /></svg>
                {p.originals.title}
              </p>
              <p class="plan__originals-copy">{p.originals.copy}</p>
            </div>
          )}
          <CtaButton origin={`club_${p.id}`} plan={p.id} label={cta.short} size="md" class="plan__cta" />
        </article>
      ))}
    </div>

    <div class="store section-dark" id="petvila-store" aria-labelledby="store-title" role="region" data-reveal>
      <h3 id="store-title" class="store__title">
        <span>{store.headline[0]}</span>
        <span class="store__title-2">{store.headline[1]}</span>
      </h3>
      <p class="store__intro">{store.intro}</p>
      <ul class="store__items" role="list">
        {store.items.map((it) => (
          <li class="store__item">
            <h4 class="store__name">{it.title}</h4>
            <p class="store__copy">{it.copy}</p>
          </li>
        ))}
      </ul>
      <p class="store__note">{store.note}</p>
    </div>
  </div>
</section>

<style>
  .club {
    padding-block: var(--section);
  }
  .club__wrap {
    position: relative;
  }
  /* Caixa PetVila em 3D, ao lado do título (só a partir do tablet). */
  .club__box {
    display: none;
  }
  @media (min-width: 900px) {
    .club__box {
      display: block;
      position: absolute;
      top: -1rem;
      right: calc(var(--gutter) + 3vw);
      width: clamp(9rem, 15vw, 13rem);
      filter: drop-shadow(0 1rem 1.2rem color-mix(in srgb, var(--fucinho) 20%, transparent));
    }
  }
  .club__title {
    font-size: var(--step-4);
    max-width: 13ch;
    margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
  }
  .club__plans {
    display: grid;
    gap: 1.25rem;
  }
  .plan {
    --mx: 50%;
    /* a forma fica na parte de cima do card, longe da lista de produtos */
    --my: 32%;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    min-height: clamp(24rem, 60vw, 36rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    /* espaço para o selo "Em breve" não encostar no conteúdo */
    padding-top: calc(clamp(1rem, 3vw, 2rem) + 8.5rem);
    border-radius: var(--radius);
    border: 1.5px solid var(--fucinho);
    background: color-mix(in srgb, var(--terra) 8%, var(--chamego));
  }
  .plan--core {
    background: var(--terra);
    border-color: var(--terra);
    color: var(--chamego);
  }
  .plan__blob {
    position: absolute;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    left: var(--mx);
    top: var(--my);
    translate: -50% -60%;
    border-radius: 58% 42% 52% 48% / 46% 56% 44% 54%;
    background: var(--patinha);
    opacity: 0.9;
    transition:
      left 900ms var(--ease-out),
      top 900ms var(--ease-out),
      scale 900ms var(--ease-out),
      rotate 1.4s var(--ease-out);
    scale: 0.8;
  }
  .plan:not(.plan--core) .plan__blob {
    background: color-mix(in srgb, var(--patinha) 30%, var(--chamego));
  }
  .plan__soon {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 7.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--fucinho);
    color: var(--chamego);
  }
  .plan--core .plan__soon {
    background: var(--chamego);
    color: var(--fucinho);
  }
  .plan__soon svg {
    width: 100%;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    fill: currentColor;
  }
  .motion .plan__soon svg {
    animation: spin 18s linear infinite;
  }
  @keyframes spin {
    to { rotate: 360deg; }
  }
  .plan__name {
    font-size: var(--step-3);
  }
  .plan__tagline {
    font-size: var(--step-1);
    font-weight: 700;
    max-width: 24ch;
    margin-top: -0.5rem;
  }
  .plan__copy {
    font-size: var(--step-0);
    max-width: 34ch;
  }
  .plan__count {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 1rem 0.35rem 0.35rem;
    border-radius: 999px;
    background: var(--fucinho);
    color: var(--chamego);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.25;
  }
  .plan__count strong {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--patinha);
    color: var(--chamego);
    font-size: var(--step-0);
  }
  .plan--core .plan__count {
    background: var(--chamego);
    color: var(--fucinho);
  }
  /* Recorrência e ciclo: discreto, logo abaixo da quantidade mensal. */
  .plan__cycle {
    margin-top: -0.35rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .plan--core .plan__cycle {
    color: color-mix(in srgb, var(--chamego) 85%, var(--terra));
  }
  .plan__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--step-0);
  }
  .plan__items li {
    position: relative;
    padding-left: 1.4rem;
  }
  .plan__items li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.5em;
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--patinha);
  }
  .plan--core .plan__items li::before {
    background: var(--chamego);
  }
  .plan__originals {
    display: grid;
    gap: 0.3rem;
    max-width: 40ch;
    padding: 1rem 1.15rem;
    border-radius: calc(var(--radius) * 0.6);
    border: 1.5px solid color-mix(in srgb, var(--chamego) 45%, transparent);
    background: color-mix(in srgb, var(--fucinho) 35%, transparent);
  }
  .plan__originals-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: var(--step-0);
  }
  .plan__originals-title svg {
    flex: none;
    color: var(--patinha);
  }
  .plan__originals-copy {
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .plan__cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
  .plan--core :global(.plan__cta) {
    background: var(--chamego);
    color: var(--fucinho);
  }
  .plan--core :global(.plan__cta:hover) {
    background: color-mix(in srgb, var(--chamego) 85%, var(--patinha));
  }

  .plan.is-hot .plan__blob,
  .plan:focus-within .plan__blob {
    scale: 1.15;
    rotate: 25deg;
  }

  /* PetVila Store + Club */
  .store {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding: clamp(1.75rem, 5vw, 4rem);
    border-radius: var(--radius);
    background: var(--fucinho);
    color: var(--chamego);
  }
  .store::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: clamp(14rem, 40vw, 30rem);
    aspect-ratio: 1;
    right: -8%;
    top: -30%;
    border-radius: 50%;
    background: var(--terra);
  }
  .store__title {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .store__title span {
    display: block;
  }
  .store__title-2 {
    color: var(--patinha);
  }
  .store__intro {
    font-size: var(--step-1);
    max-width: 38ch;
  }
  .store__items {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .store__item {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .store__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .store__name::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.5em;
    border-radius: 50% 50% 50% 0;
    background: var(--patinha);
    transform: rotate(-45deg) translateY(-0.05em);
  }
  .store__copy {
    font-size: var(--step-0);
    max-width: 34ch;
    color: color-mix(in srgb, var(--chamego) 88%, var(--fucinho));
  }
  .store__note {
    font-size: var(--step--1);
    font-weight: 600;
    max-width: 52ch;
    color: color-mix(in srgb, var(--chamego) 80%, var(--fucinho));
  }

  @media (min-width: 760px) {
    .store__items {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
  @media (min-width: 960px) {
    .club__plans {
      grid-template-columns: 1fr 1.3fr;
      align-items: stretch;
    }
    .plan--core {
      min-height: 40rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .plan:hover .plan__blob {
      scale: 1.15;
      rotate: 25deg;
    }
    .plan:hover .plan__soon svg {
      animation-duration: 6s;
    }
  }
</style>
