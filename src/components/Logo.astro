---
/**
 * Logo oficial (petvila + club.), inline para herdar a cor do tom.
 * Vetorizado a partir do print enviado pelo Felipe; trocar src/assets/brand/logo-petvila.svg
 * pelo vetor oficial quando chegar. Nunca redesenhar o logo aqui.
 */
import raw from '../assets/brand/logo-petvila.svg?raw';

interface Props {
  /** dark = Fucinho, light = Chamego, brand = Patinha */
  tone?: 'dark' | 'light' | 'brand';
  class?: string;
  height?: string;
}
const { tone = 'dark', class: cls = '', height = '2.25rem' } = Astro.props;
const svg = raw.replace(/\s(role|aria-label)="[^"]*"/g, '').replace('<svg ', '<svg role="img" aria-label="PetVila Club" focusable="false" ');
---

<span class={`logo ${cls}`} data-tone={tone} style={`--h:${height}`} set:html={svg} />

<style>
  .logo {
    display: inline-flex;
    height: var(--h);
    color: var(--fucinho);
    line-height: 0;
  }
  .logo[data-tone='light'] {
    color: var(--chamego);
  }
  .logo[data-tone='brand'] {
    color: var(--patinha);
  }
  .logo :global(svg) {
    height: 100%;
    width: auto;
  }
</style>
