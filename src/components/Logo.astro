---
/**
 * Logo oficial. Enquanto src/assets/brand/logo-petvila(-claro).svg não existir,
 * mostra um placeholder marcado. Nunca redesenhar o logo aqui.
 */
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
  height?: string;
}
const { tone = 'dark', class: cls = '', height = '2.25rem' } = Astro.props;
const files = import.meta.glob<{ default: { src: string } }>('../assets/brand/logo-petvila*.svg', { eager: true });
const pick = tone === 'light' ? files['../assets/brand/logo-petvila-claro.svg'] : undefined;
const official = pick ?? files['../assets/brand/logo-petvila.svg'];
---

{official ? (
  <img src={official.default.src} alt="PetVila Club" class={`logo ${cls}`} style={`height:${height}`} />
) : (
  <span class={`logo logo--placeholder ${cls}`} data-tone={tone} style={`--h:${height}`} role="img" aria-label="PetVila Club">
    <span aria-hidden="true">PetVila</span>
    <small aria-hidden="true">logo oficial</small>
  </span>
)}

<style>
  .logo {
    width: auto;
  }
  .logo--placeholder {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--h);
    padding: 0 0.7em;
    border: 1.5px dashed currentColor;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--h) * 0.5);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo--placeholder small {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, 0.25rem);
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
    white-space: nowrap;
  }
</style>
