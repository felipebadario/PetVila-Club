---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from './Logo.astro';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <header class="sp-h wrap"><a href="/" aria-label="PetVila Club, página inicial"><Logo /></a></header>
  <main id="conteudo" class="sp wrap"><slot /></main>
</BaseLayout>

<style>
  .sp-h { padding-block: 1.25rem; }
  .sp-h a { display: inline-flex; text-decoration: none; }
  .sp { padding-block: 3rem 6rem; max-width: 46rem; margin-inline: 0; }
  .sp :global(h1) { font-size: var(--step-4); margin-bottom: 1.5rem; }
  .sp :global(h2) { font-size: var(--step-2); margin: 2.5rem 0 0.75rem; }
  .sp :global(p), .sp :global(li) { margin-bottom: 0.75rem; }
  .sp :global(.pending) { padding: 1rem 1.25rem; border: 1.5px dashed var(--terra); border-radius: 1rem; }
</style>
