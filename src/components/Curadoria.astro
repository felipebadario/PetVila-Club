---
import Photo from './Photo.astro';
import { photos } from '../content/photos';
import { curadoria } from '../content/copy';
const tones = ['patinha', 'terra', 'fucinho', 'patinha'] as const;
---

<section class="cur" id="curadoria" aria-labelledby="cur-title" data-curadoria>
  <div class="wrap">
    <div class="cur__head">
      <p class="eyebrow" data-reveal>{curadoria.eyebrow}</p>
      <h2 id="cur-title" class="cur__title">
        <span class="cur__line" data-reveal style="--reveal-i:1">{curadoria.headline[0]}</span>
        <span class="cur__line" data-reveal style="--reveal-i:2">
          Mais coisas <span class="cur__mark">certas.<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C 60 6, 120 4, 180 10 S 270 20, 296 8" fill="none" stroke="var(--patinha)" stroke-width="7" stroke-linecap="round" pathLength="1" /></svg></span>
        </span>
      </h2>
      <p class="cur__intro" data-reveal style="--reveal-i:3">{curadoria.intro}</p>
    </div>

    <ul class="cur__list" role="list">
      {curadoria.categories.map((c, i) => (
        <li class="cur__item" data-reveal style={`--reveal-i:${i}`} data-cat={i}>
          <span class="cur__num" aria-hidden="true">0{i + 1}</span>
          <h3 class="cur__name">{c.label}</h3>
          <p class="cur__desc">{c.copy}</p>
          <Photo photo={photos.curadoria[c.id as keyof typeof photos.curadoria]} shape="circle" ratio="1:1" sizes="5rem" decorative class="cur__thumb" />
        </li>
      ))}
    </ul>

    <p class="cur__support" data-reveal>{curadoria.support}</p>
  </div>

  <!-- Imagem que segue o cursor (só desktop com mouse). -->
  <div class="cur__float" aria-hidden="true" data-cur-float>
    {curadoria.categories.map((c, i) => (
      <Photo photo={photos.curadoria[c.id as keyof typeof photos.curadoria]} shape="arch" ratio="3:4" sizes="15rem" tone={tones[i] === 'fucinho' ? 'fucinho' : tones[i]} decorative class="cur__float-img" />
    ))}
  </div>
</section>

<style>
  .cur {
    position: relative;
    padding-block: var(--section);
  }
  .cur__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .cur__title {
    font-size: var(--step-4);
  }
  .cur__line {
    display: block;
  }
  .cur__mark {
    position: relative;
    display: inline-block;
  }
  .cur__mark svg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.22em;
    overflow: visible;
  }
  .motion .cur__mark path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s 0.5s var(--ease-out);
  }
  .motion .is-in .cur__mark path {
    stroke-dashoffset: 0;
  }
  .cur__intro {
    font-size: var(--step-1);
    max-width: 34ch;
    color: var(--ink-soft);
  }
  .cur__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--fucinho);
  }
  .cur__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    align-items: baseline;
    padding: 1.4rem 0.25rem;
    border-bottom: 1.5px solid var(--fucinho);
    isolation: isolate;
  }
  .cur__item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--patinha);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 500ms var(--ease-out);
  }
  .cur__num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .cur__name {
    font-size: var(--step-3);
    transition: transform 600ms var(--ease-out);
  }
  .cur__desc {
    grid-column: 2;
    margin-top: 0.4rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .cur__support {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-2);
    line-height: 1.15;
    max-width: 26ch;
    margin-left: auto;
  }
  .cur__float {
    display: none;
  }
  .cur__item {
    grid-template-columns: auto 1fr auto;
  }
  .cur__item :global(.cur__thumb) {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    width: 4.5rem;
    height: 4.5rem;
  }

  @media (min-width: 960px) {
    .cur__head {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
    .cur__head .eyebrow {
      grid-column: 1 / -1;
    }
    .cur__item {
      grid-template-columns: 4rem 1fr 1fr auto;
      column-gap: 1.5rem;
      padding-block: 1.8rem;
    }
    .cur__item :global(.cur__thumb) {
      grid-column: 4;
      grid-row: 1;
    }
    .cur__desc {
      grid-column: 3;
      margin-top: 0;
      text-align: right;
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 960px) {
    .cur__item:hover::before {
      transform: scaleY(1);
    }
    .cur__item:hover .cur__name {
      transform: translateX(1.25rem);
    }
    .cur__item:hover .cur__desc {
      color: var(--fucinho);
    }
    .cur__item :global(.cur__thumb) {
      display: none;
    }
    .cur__item {
      grid-template-columns: 4rem 1fr 1fr;
    }
    .cur__float {
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      width: 15rem;
      aspect-ratio: 3 / 4;
      pointer-events: none;
      z-index: 2;
      opacity: 0;
      scale: 0.6;
      transition:
        opacity 300ms ease,
        scale 500ms var(--ease-spring);
      will-change: transform;
    }
    .cur__float.is-on {
      opacity: 1;
      scale: 1;
    }
    :global(.cur__float-img) {
      position: absolute !important;
      inset: 0;
      opacity: 0;
      transition: opacity 250ms ease;
    }
    :global(.cur__float-img.is-on) {
      opacity: 1;
    }
  }
</style>
