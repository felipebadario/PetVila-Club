---
import Logo from './Logo.astro';
import { cta } from '../content/copy';
---

<header class="hdr" data-header>
  <div class="hdr__in wrap">
    <a href="#topo" class="hdr__home" aria-label="PetVila Club, voltar ao início"><Logo height="2.5rem" /></a>
    <nav aria-label="Seções" class="hdr__nav">
      <a href="#rotina">A rotina</a>
      <a href="#curadoria">Curadoria</a>
      <a href="#club">O Club</a>
    </nav>
    <button type="button" class="hdr__cta" data-open-lead="header" aria-haspopup="dialog">
      <span class="hdr__cta-long">Primeiros da Vila</span><span class="hdr__cta-short" aria-hidden="true">Entrar</span>
      <span class="visually-hidden">: {cta.primary}</span>
    </button>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 0.9rem;
    transition:
      transform 500ms var(--ease-out),
      background-color 300ms ease,
      box-shadow 300ms ease;
  }
  .hdr.is-scrolled {
    background: color-mix(in srgb, var(--chamego) 92%, transparent);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr.is-hidden {
    transform: translateY(-110%);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hdr__home {
    text-decoration: none;
    display: inline-flex;
  }
  .hdr__nav {
    display: none;
    gap: 2rem;
    font-weight: 500;
  }
  .hdr__nav a {
    text-decoration: none;
    background: linear-gradient(var(--patinha), var(--patinha)) 0 100% / 0 2px no-repeat;
    transition: background-size 400ms var(--ease-out);
    padding-block: 0.25rem;
  }
  .hdr__nav a:hover,
  .hdr__nav a:focus-visible {
    background-size: 100% 2px;
  }
  .hdr__cta {
    border: 1.5px solid var(--fucinho);
    background: transparent;
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    min-height: 2.75rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color 250ms ease, color 250ms ease;
  }
  .hdr__cta:hover {
    background: var(--fucinho);
    color: var(--chamego);
  }
  .hdr__cta-short { display: none; }
  @media (max-width: 380px) {
    .hdr__cta-long { display: none; }
    .hdr__cta-short { display: inline; }
  }
  @media (min-width: 960px) {
    .hdr__nav { display: flex; }
  }
</style>
