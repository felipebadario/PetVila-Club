---
import BrandArt from './BrandArt.astro';
import { manifesto } from '../content/copy';
const full = manifesto.lines.join(' ');
const lines = manifesto.lines.map((l) => l.split(' '));
let k = 0;
const closing = manifesto.closing.split(/(Vila)/);
---

<section class="man section-dark" aria-label="Manifesto" data-manifesto>
  <div class="man__track">
    <div class="man__sticky">
      <div class="man__copy wrap">
        <p class="man__text" aria-label={full}>
          {lines.map((words) => (
            <span class="man__line" aria-hidden="true">
              {words.map((w) => <span class="man__w" style={`--k:${k++}`}>{w} </span>)}
            </span>
          ))}
        </p>
        <p class="man__closing" data-closing>
          {closing.map((part) => (part === 'Vila' ? <em>Vila</em> : part))}
        </p>
      </div>
      <!-- A Vila: fileira de casinhas mais larga que a tela, percorrida na horizontal com o scroll. -->
      <div class="man__village" aria-hidden="true">
        <BrandArt art="vila" class="man__village-art" />
      </div>
    </div>
  </div>
</section>

<style>
  .man {
    position: relative;
    background: var(--terra);
    color: var(--chamego);
    overflow: clip;
  }
  .man__track {
    height: 220svh;
  }
  /* Com movimento, o trilho ganha 200svh para percorrer a Vila depois que a frase acende. */
  :global(.js.motion) .man__track {
    height: 420svh;
  }
  /* Texto em cima e Vila embaixo no mesmo quadro fixo: a Vila nunca cobre a frase. */
  .man__sticky {
    position: sticky;
    /* Em telas baixas o quadro passa de 100svh: o JS sobe o `top` até a Vila encostar na base. */
    top: var(--pin, 0px);
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .man__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 6vw, 4rem);
    padding-block: 5rem clamp(1.5rem, 4svh, 3rem);
  }
  .man__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .man__line {
    display: block;
  }
  .man__line + .man__line {
    margin-top: 0.3em;
  }
  .man__w {
    --on: 1;
    opacity: calc(0.16 + 0.84 * var(--on));
    transition: opacity 250ms linear;
  }
  :global(.js.motion) .man__w {
    --on: 0;
  }
  :global(.js.motion) .man__w.is-on {
    --on: 1;
  }
  .man__closing {
    font-size: var(--step-3);
    transition:
      opacity 800ms ease,
      transform 1s var(--ease-out);
    font-family: var(--font-display);
    line-height: 1.15;
    max-width: 18ch;
    margin-left: auto;
  }
  :global(.js.motion) .man__closing:not(.is-on) {
    opacity: 0;
    transform: translateY(2rem);
  }
  .man__closing em {
    font-style: normal;
    color: var(--patinha);
  }
  .man__village {
    height: clamp(6rem, min(15vw, 24svh), 13.75rem);
    overflow: hidden;
  }
  /* A faixa mantém a proporção do SVG e desliza da direita para a esquerda (--x vem do scroll). */
  .man__village :global(.man__village-art) {
    height: 100%;
    width: max-content;
    transform: translate3d(var(--x, 0px), 0, 0);
    will-change: transform;
  }
  .man__village :global(.man__village-art svg) {
    display: block;
    height: 100%;
    width: auto;
    aspect-ratio: 3456 / 220;
  }
  @media (max-width: 759px) {
    .man__text { font-size: clamp(2.3rem, 10.5vw, 3.4rem); }
  }
</style>
