---
import BrandArt from './BrandArt.astro';
import { manifesto } from '../content/copy';
const full = manifesto.lines.join(' ');
const lines = manifesto.lines.map((l) => l.split(' '));
let k = 0;
const closing = manifesto.closing.split(/(Vila)/);
---

<section class="man section-dark" aria-label="Manifesto" data-manifesto>
  <div class="man__track">
    <div class="man__sticky wrap">
      <p class="man__text" aria-label={full}>
        {lines.map((words) => (
          <span class="man__line" aria-hidden="true">
            {words.map((w) => <span class="man__w" style={`--k:${k++}`}>{w} </span>)}
          </span>
        ))}
      </p>
      <p class="man__closing" data-closing>
        {closing.map((part) => (part === 'Vila' ? <em>Vila</em> : part))}
      </p>
    </div>
  </div>
  <!-- A Vila: fileira de casinhas mais larga que a tela, que desliza para a esquerda enquanto passa pela tela. -->
  <div class="man__village" aria-hidden="true">
    <BrandArt art="vila" class="man__village-art" />
  </div>
</section>

<style>
  .man {
    position: relative;
    background: var(--terra);
    color: var(--chamego);
    overflow: clip;
  }
  .man__track {
    height: 220svh;
  }
  .man__sticky {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 6vw, 4rem);
    padding-block: 5rem;
  }
  .man__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .man__line {
    display: block;
  }
  .man__line + .man__line {
    margin-top: 0.3em;
  }
  .man__w {
    --on: 1;
    opacity: calc(0.16 + 0.84 * var(--on));
    transition: opacity 250ms linear;
  }
  :global(.js.motion) .man__w {
    --on: 0;
  }
  :global(.js.motion) .man__w.is-on {
    --on: 1;
  }
  .man__closing {
    font-size: var(--step-3);
    transition:
      opacity 800ms ease,
      transform 1s var(--ease-out);
    font-family: var(--font-display);
    line-height: 1.15;
    max-width: 18ch;
    margin-left: auto;
  }
  :global(.js.motion) .man__closing:not(.is-on) {
    opacity: 0;
    transform: translateY(2rem);
  }
  .man__closing em {
    font-style: normal;
    color: var(--patinha);
  }
  /* Fica no fluxo, abaixo do trilho do texto fixo: assim nunca cobre a frase. */
  .man__village {
    height: clamp(6rem, 15vw, 13.75rem);
    overflow: hidden;
  }
  /* A faixa mantém a proporção do SVG e desliza da direita para a esquerda (--x vem do scroll). */
  .man__village :global(.man__village-art) {
    height: 100%;
    width: max-content;
    transform: translate3d(var(--x, 0px), 0, 0);
    will-change: transform;
  }
  .man__village :global(.man__village-art svg) {
    display: block;
    height: 100%;
    width: auto;
    aspect-ratio: 2880 / 220;
  }
  @media (max-width: 759px) {
    .man__text { font-size: clamp(2.3rem, 10.5vw, 3.4rem); }
  }
</style>
