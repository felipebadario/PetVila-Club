# Copie para .env (desenvolvimento) e configure as mesmas chaves no painel
# da hospedagem para Preview e Production. Nunca commite o .env.

# --- Públicas (vão para o navegador; prefixo PUBLIC_) ---
# URL canônica do site. Em preview pode apontar para a URL temporária.
PUBLIC_SITE_URL=https://petvilaclub.com.br
# Ambiente: development | preview | production
PUBLIC_APP_ENV=development
# Analytics: deixe vazio para não carregar nada.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# --- Privadas (só no servidor; nunca use PUBLIC_ aqui) ---
# Para onde /api/leads encaminha cada cadastro (CRM, planilha, automação).
# Vazio em desenvolvimento: os leads vão para .data/leads.jsonl.
LEADS_WEBHOOK_URL=
# Enviado como Authorization: Bearer <token> para o webhook, se definido.
LEADS_WEBHOOK_TOKEN=

# Só para prévias estáticas sem servidor: o cadastro simula sucesso e não envia nada.
# Nunca ative em produção.
PUBLIC_DEMO_MODE=false
