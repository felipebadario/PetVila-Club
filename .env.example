# Copie para .env (desenvolvimento) e configure as mesmas chaves no painel
# da hospedagem para Preview e Production. Nunca commite o .env.

# --- Públicas (vão para o navegador; prefixo PUBLIC_) ---
# URL canônica do site. Em preview pode apontar para a URL temporária.
PUBLIC_SITE_URL=https://petvilaclub.com.br
# Ambiente: development | preview | production
PUBLIC_APP_ENV=development
# Analytics: deixe vazio para não carregar nada.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# --- Privadas (só no servidor; nunca use PUBLIC_ aqui) ---
# Planilha Google (Apps Script em integrations/google-sheets/Code.gs).
# URL da implantação (termina em /exec) e o mesmo TOKEN das propriedades do script.
# Vazio em desenvolvimento: os leads vão para .data/leads.jsonl.
LEADS_SHEETS_URL=
LEADS_SHEETS_TOKEN=
# Alternativa: webhook genérico (só grava; o CRM fica indisponível).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# WhatsApp (Meta Cloud API). Só servidor. Valores reais apenas no painel da Vercel.
# Detalhes, fluxo e checklist da Meta: docs/whatsapp.md
# Lidas só de process.env: em desenvolvimento, exporte no terminal (o .env não vale para elas).
# Liga o envio das boas-vindas. Com false o cadastro e o opt-in funcionam e nada é enviado.
WHATSAPP_ENABLED=false
# Token de acesso permanente (usuário do sistema no Business Manager). Nunca commite.
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone e ID da conta do WhatsApp Business (painel do app na Meta).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Versão da Graph API no formato vNN.N, a mesma exibida no painel do app.
WHATSAPP_API_VERSION=
# Texto livre escolhido por nós; o mesmo vai no campo "Verificar token" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Configurações do app > Básico). Valida a assinatura dos webhooks.
WHATSAPP_APP_SECRET=
# Template de boas-vindas aprovado na Meta.
WHATSAPP_WELCOME_TEMPLATE_NAME=
WHATSAPP_WELCOME_TEMPLATE_LANGUAGE=pt_BR
# Vazio se a variável do template for {{1}}; "nome" se o template usar {{nome}}.
WHATSAPP_WELCOME_TEMPLATE_PARAM_NAME=

# CRM em /crm: senha de acesso e segredo para assinar a sessão (strings longas e aleatórias).
CRM_PASSWORD=
CRM_SESSION_SECRET=

# Só para prévias estáticas sem servidor: o cadastro simula sucesso e não envia nada.
# Nunca ative em produção.
PUBLIC_DEMO_MODE=false
